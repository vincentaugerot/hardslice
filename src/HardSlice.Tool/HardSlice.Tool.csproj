<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- A local tool: .config/dotnet-tools.json of a generated solution pins it to the version of HardSlice.Analyzers. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-hardslice</ToolCommandName>
    <PackageId>HardSlice.Tool</PackageId>
    <Description>The dotnet hardslice command: verifies a HardSlice solution and explains its rules.</Description>
    <PackageTags>dotnet-tool;architecture;vertical-slices;ddd;cqrs</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The single source of the rule sheets: the template ships them, the tool embeds them for explain. -->
    <RuleSheetsDir>../HardSlice.Templates/content/hardslice-api/docs/rules/</RuleSheetsDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(RuleSheetsDir)HS*.md"
                      LogicalName="HardSlice.Tool.Rules.%(Filename)%(Extension)"
                      Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HardSlice.Tool.Tests" />
  </ItemGroup>

</Project>
