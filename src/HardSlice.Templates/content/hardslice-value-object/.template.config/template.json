{
  "$schema": "http://json.schemastore.org/template",
  "author": "Vincent Augerot",
  "classifications": [
    "Web",
    "API",
    "Vertical Slices",
    "DDD"
  ],
  "identity": "HardSlice.Templates.ValueObject",
  "name": "HardSlice value object",
  "description": "A value object of the domain of a module of a hardslice-api solution: a sealed record whose constructor takes the values of --fields and checks their rules, throwing DomainException, and its unit tests. Run it from the root of the solution with --project src/<App>/<App>.csproj.",
  "shortName": "hardslice-value-object",
  "sourceName": "ValueObjectName",
  "preferNameDirectory": false,
  "preferDefaultName": true,
  "defaultName": "HardSliceNameMissing",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "Module": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The module of the value object, in PascalCase, such as Reliability: src/<App>/Features/<Module>/<Module>Module.cs must exist.",
      "replaces": "ModuleName",
      "fileRename": "ModuleName"
    },
    "Fields": {
      "type": "parameter",
      "datatype": "text",
      "description": "The values of the value object, as <Name>:<Type>[,<Name>:<Type>...]: PascalCase names, each with one of the types string, bool, int, long, decimal, double, Guid, DateOnly, TimeOnly and DateTimeOffset, or a type of the domain in PascalCase, such as another value object or an enum, followed by ? when the value is optional, such as Level:InterpretationLevel,Justification:string,Note:string?. Each one is a parameter of the constructor and a property without setter. A required string cannot be blank, refused with its test, and the compiler already refuses a null for a required field. Value:decimal by default."
    },
    "AppName": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "replaces": "MyApp",
      "fileRename": "MyApp"
    },
    "ModuleFiles": {
      "type": "bind",
      "binding": "msbuild:HardSliceModuleFiles"
    },
    "DomainFiles": {
      "type": "bind",
      "binding": "msbuild:HardSliceDomainFiles"
    },
    "Unbound": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": ""
      }
    },
    "AppNameOrEmpty": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "AppName",
        "fallbackVariableName": "Unbound"
      }
    },
    "DomainFilesOrEmpty": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "DomainFiles",
        "fallbackVariableName": "Unbound"
      }
    },
    "AppIsKnown": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "AppNameOrEmpty",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
      }
    },
    "NameIsGiven": {
      "type": "computed",
      "value": "(name != \"HardSliceNameMissing\")"
    },
    "NameIsPascalCase": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "name",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "ModuleIsPascalCase": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "Module",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "ModuleProbe": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "Module"
          },
          {
            "type": "const",
            "value": "|"
          },
          {
            "type": "ref",
            "value": "ModuleFiles"
          }
        ]
      }
    },
    "ModuleExists": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "ModuleProbe",
        "pattern": "^([A-Za-z0-9]+)\\|(?:.*;)?[^;]*[/\\\\]Features[/\\\\]\\1[/\\\\]\\1Module\\.cs(?:;|$)"
      }
    },
    "NameProbe": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "name"
          },
          {
            "type": "const",
            "value": "|"
          },
          {
            "type": "ref",
            "value": "ModuleFiles"
          }
        ]
      }
    },
    "NameIsModule": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "NameProbe",
        "pattern": "^([A-Za-z0-9]+)\\|(?:.*;)?[^;]*[/\\\\]Features[/\\\\]\\1[/\\\\]\\1Module\\.cs(?:;|$)"
      }
    },
    "AppProbe": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "name"
          },
          {
            "type": "const",
            "value": "|"
          },
          {
            "type": "ref",
            "value": "AppNameOrEmpty"
          }
        ]
      }
    },
    "NameIsNamespace": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "AppProbe",
        "pattern": "^(?:(?:Domain|Features|Shared|Tests|IntegrationTests|ArchitectureTests)\\||([A-Za-z0-9]+)\\|(?:[^|]*\\.)?\\1(?:\\.[^|]*)?$)"
      }
    },
    "NameIsImportedType": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "name",
        "pattern": "^(?:Action|Array|Assert|Attribute|Barrier|Buffer|Console|Convert|Delegate|Directory|Endpoint|Enum|Environment|Exception|File|FormFile|Guid|Host|Index|Lock|Math|Monitor|Mutex|Object|Parallel|Path|Random|Range|Record|Results|Route|Semaphore|Should|Stream|String|Task|TestContext|Thread|Timeout|Timer|Tuple|Type|TypedResults|Uri|Version)$"
      }
    },
    "ExistingNameProbe": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "Module"
          },
          {
            "type": "const",
            "value": "|"
          },
          {
            "type": "ref",
            "value": "name"
          },
          {
            "type": "const",
            "value": "|"
          },
          {
            "type": "ref",
            "value": "DomainFilesOrEmpty"
          }
        ]
      }
    },
    "NameExists": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "ExistingNameProbe",
        "pattern": "^([A-Za-z0-9]+)\\|([A-Za-z0-9]+)\\|(?:.*;)?[^;]*(?:\\.Domain[/\\\\]\\1[/\\\\]\\2\\.cs|\\.Tests[/\\\\]Domain[/\\\\]\\1[/\\\\]\\2Tests\\.cs)(?:;|$)"
      }
    },
    "NameIsFree": {
      "type": "computed",
      "value": "(!NameIsModule && !NameIsNamespace && !NameIsImportedType)"
    },
    "Accepted": {
      "type": "computed",
      "value": "(AppIsKnown && NameIsGiven && NameIsPascalCase && ModuleIsPascalCase && ModuleExists && NameIsFree && !NameExists && FieldsAreWellFormed && FieldTypesAreKnown && !FieldsHaveDuplicate && !FieldIsTheType && !FieldIsRecordMember)"
    },
    "DefaultFields": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "Value:decimal"
      }
    },
    "FieldsText": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "Fields",
        "fallbackVariableName": "DefaultFields"
      },
      "fileRename": "FieldsText"
    },
    "FieldsList": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "FieldsText",
        "steps": [
          {
            "regex": "\\s+",
            "replacement": ""
          }
        ]
      }
    },
    "FieldsAreWellFormed": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "FieldsList",
        "pattern": "^[A-Z][A-Za-z0-9]*:[^:,]+(?:,[A-Z][A-Za-z0-9]*:[^:,]+)*$"
      }
    },
    "FieldTypesAreKnown": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "FieldsList",
        "pattern": "^[^:,]*:(?:(?:string|bool|int|long|decimal|double)\\??|[A-Z][A-Za-z0-9]*\\??)(?:,[^:,]*:(?:(?:string|bool|int|long|decimal|double)\\??|[A-Z][A-Za-z0-9]*\\??))*$"
      }
    },
    "UnknownFieldName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "FieldsList",
        "steps": [
          {
            "regex": "^(?:[^,]*,)*?([^:,]*):(?!(?:(?:string|bool|int|long|decimal|double)\\??|[A-Z][A-Za-z0-9]*\\??)(?:,|$))[^,]*(?:,.*)?$",
            "replacement": "$1"
          }
        ]
      },
      "fileRename": "UnknownFieldName"
    },
    "UnknownFieldType": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "FieldsList",
        "steps": [
          {
            "regex": "^(?:[^,]*,)*?[^:,]*:(?!(?:(?:string|bool|int|long|decimal|double)\\??|[A-Z][A-Za-z0-9]*\\??)(?:,|$))([^,]*)(?:,.*)?$",
            "replacement": "$1"
          }
        ]
      },
      "fileRename": "UnknownFieldType"
    },
    "FieldsHaveDuplicate": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "FieldsList",
        "pattern": "(?i)(?:^|,)([A-Za-z0-9]+):[^,]*,(?:[^,]*,)*?\\1:"
      }
    },
    "DuplicateFieldName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "FieldsList",
        "steps": [
          {
            "regex": "(?i)^(?:[^,]*,)*?([A-Za-z0-9]+):[^,]*,(?:[^,]*,)*?\\1:.*$",
            "replacement": "$1"
          }
        ]
      },
      "fileRename": "DuplicateFieldName"
    },
    "FieldNameProbe": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "name"
          },
          {
            "type": "const",
            "value": "|"
          },
          {
            "type": "ref",
            "value": "FieldsList"
          }
        ]
      }
    },
    "FieldIsTheType": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "FieldNameProbe",
        "pattern": "^([A-Za-z0-9]+)\\|(?:.*,)?\\1:"
      }
    },
    "FieldIsRecordMember": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "FieldsList",
        "pattern": "(?:^|,)(?:Equals|GetHashCode|ToString|GetType|Deconstruct|EqualityContract|PrintMembers|MemberwiseClone|Finalize):"
