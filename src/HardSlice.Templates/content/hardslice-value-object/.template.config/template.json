    },
    "RecordMemberField": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "FieldsList",
        "steps": [
          {
            "regex": "^(?:[^,]*,)*?(Equals|GetHashCode|ToString|GetType|Deconstruct|EqualityContract|PrintMembers|MemberwiseClone|Finalize):.*$",
            "replacement": "$1"
          }
        ]
      },
      "fileRename": "RecordMemberField"
    },
