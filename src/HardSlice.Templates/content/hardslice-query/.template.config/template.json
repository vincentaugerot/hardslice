{
  "$schema": "http://json.schemastore.org/template",
  "author": "Vincent Augerot",
  "classifications": [
    "Web",
    "API",
    "Vertical Slices",
    "DDD"
  ],
  "identity": "HardSlice.Templates.Query",
  "name": "HardSlice query slice",
  "description": "A query slice of a hardslice-api solution: query, DTO, handler reading its aggregate without tracking, endpoint and integration tests, and with --result filtered the validator of its filter and its tests. --route chooses the route of its endpoint, which answers GET. Run it from the root of the solution with --project src/<App>/<App>.csproj.",
  "shortName": "hardslice-query",
  "sourceName": "QueryName",
  "preferNameDirectory": false,
  "preferDefaultName": true,
  "defaultName": "HardSliceNameMissing",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "forms": {
    "firstLowerCase": {
      "identifier": "firstLowerCaseInvariant"
    }
  },
  "symbols": {
    "Module": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The module of the slice, in PascalCase, such as Bookings: src/<App>/Features/<Module>/<Module>Module.cs must exist.",
      "replaces": "ModuleName",
      "fileRename": "ModuleName"
    },
    "Aggregate": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The aggregate that the query reads, in PascalCase, such as Booking: a type of namespace <App>.Domain.<Module>, whose Id property is a <Aggregate>Id that wraps a Guid Value.",
      "replaces": "AggregateName",
      "fileRename": "AggregateName"
    },
    "Result": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "single",
      "description": "What the query returns: single (one DTO read by its id, null answered with 404, by default), many (the list of the DTOs) or filtered (the list of the DTOs that the filter of --parameter selects, read from the query string and checked by a validator). Not list: dotnet new would read it as its list command.",
      "choices": [
        {
          "choice": "single",
          "description": "One DTO read by its id; an unknown id is answered with 404."
        },
        {
          "choice": "many",
          "description": "The list of the DTOs."
        },
        {
          "choice": "filtered",
          "description": "The list of the DTOs that the filter of --parameter selects; a request without it is answered with 400."
        }
      ]
    },
    "Parameter": {
      "type": "parameter",
      "datatype": "text",
      "description": "The filter of --result filtered, as <Name>:<Type>: a PascalCase name and one of the types string, bool, int, long, decimal, double, Guid, DateOnly, TimeOnly and DateTimeOffset, such as Date:DateOnly. The query reads it from the query string, such as ?date=2026-11-04, and its validator answers 400 to a request without it. Required with --result filtered, refused otherwise."
    },
    "Route": {
      "type": "parameter",
      "datatype": "text",
      "description": "The route of the endpoint under the group of the module, chosen after the resource it reads rather than the use case: lowercase words separated by hyphens, and route parameters between braces such as {id:guid}, separated by slashes, such as trips or {roomId:guid}/bookings, or / for the group itself. The name of the slice in kebab-case by default. With --result single, /{id:guid} follows it."
    },
    "Method": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "GET",
      "description": "The HTTP method of the endpoint: GET, the only method of a query, which only reads."
    },
    "AppName": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "replaces": "MyApp",
      "fileRename": "MyApp"
    },
    "ModuleFiles": {
      "type": "bind",
      "binding": "msbuild:HardSliceModuleFiles"
    },
    "Unbound": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": ""
      }
    },
    "AppNameOrEmpty": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "AppName",
        "fallbackVariableName": "Unbound"
      }
    },
    "ParameterText": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "Parameter",
        "fallbackVariableName": "Unbound"
      },
      "fileRename": "ParameterText"
    },
    "ParameterIsGiven": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "ParameterText",
        "pattern": "."
      }
    },
    "ParameterIsWellFormed": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "ParameterText",
        "pattern": "^[A-Z][A-Za-z0-9]*:[^:]+$"
      }
    },
    "FilterName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "ParameterText",
        "steps": [
          {
            "regex": "^([^:]*):.*$",
            "replacement": "$1"
          }
        ]
      },
      "replaces": "FilterName",
      "fileRename": "FilterName"
    },
    "FilterKey": {
      "type": "derived",
      "valueSource": "FilterName",
      "valueTransform": "firstLowerCase",
      "replaces": "filterName",
      "fileRename": "filterName"
    },
    "FilterType": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "ParameterText",
        "steps": [
          {
            "regex": "^[^:]*:",
            "replacement": ""
          }
        ]
      },
      "replaces": "FilterType",
      "fileRename": "FilterType"
    },
    "FilterTypeIsKnown": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "FilterType",
        "pattern": "^(?:string|bool|int|long|decimal|double|Guid|DateOnly|TimeOnly|DateTimeOffset)$"
      }
    },
    "FilterIsString": {
      "type": "computed",
      "value": "(FilterType == \"string\")"
    },
    "FilterValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "FilterValue",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(FilterType == \"string\")",
            "value": "\"value\""
          },
          {
            "condition": "(FilterType == \"bool\")",
            "value": "true"
          },
          {
            "condition": "(FilterType == \"int\")",
            "value": "1"
          },
          {
            "condition": "(FilterType == \"long\")",
            "value": "1L"
          },
          {
            "condition": "(FilterType == \"decimal\")",
            "value": "1.5m"
          },
          {
            "condition": "(FilterType == \"double\")",
            "value": "1.5"
          },
          {
            "condition": "(FilterType == \"Guid\")",
            "value": "Guid.NewGuid()"
          },
          {
            "condition": "(FilterType == \"DateOnly\")",
            "value": "new DateOnly(2026, 11, 4)"
          },
          {
            "condition": "(FilterType == \"TimeOnly\")",
            "value": "new TimeOnly(8, 30)"
          },
          {
            "condition": "(FilterType == \"DateTimeOffset\")",
            "value": "new DateTimeOffset(2026, 11, 4, 8, 30, 0, TimeSpan.Zero)"
          },
          {
            "value": "default"
          }
        ]
      }
    },
    "FilterQueryValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "filter-query-value",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(FilterType == \"string\")",
            "value": "value"
          },
          {
            "condition": "(FilterType == \"bool\")",
            "value": "true"
          },
          {
            "condition": "(FilterType == \"int\")",
            "value": "1"
          },
          {
            "condition": "(FilterType == \"long\")",
            "value": "1"
          },
          {
            "condition": "(FilterType == \"decimal\")",
            "value": "1.5"
          },
          {
            "condition": "(FilterType == \"double\")",
            "value": "1.5"
          },
          {
            "condition": "(FilterType == \"Guid\")",
            "value": "0f8fad5b-d9cb-469f-a165-70867728950e"
          },
          {
            "condition": "(FilterType == \"DateOnly\")",
            "value": "2026-11-04"
          },
          {
            "condition": "(FilterType == \"TimeOnly\")",
            "value": "08:30"
          },
          {
            "condition": "(FilterType == \"DateTimeOffset\")",
            "value": "2026-11-04T08:30:00%2B00:00"
          },
          {
            "value": ""
          }
        ]
      }
    },
    "QueryRouteWords": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "(?<=[a-z0-9])([A-Z])",
            "replacement": "-$1"
          }
        ]
      }
    },
    "QueryRoute": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "QueryRouteWords",
        "toLower": true
      }
    },
    "RouteOrDefault": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "Route",
        "fallbackVariableName": "QueryRoute"
      }
    },
    "SliceRoute": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "RouteOrDefault",
        "steps": [
          {
            "regex": "^/",
            "replacement": ""
          }
        ]
      },
      "fileRename": "slice-route"
    },
    "EndpointRoute": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "SliceRoute",
        "steps": [
          {
            "regex": "^",
            "replacement": "/"
          }
        ]
      },
      "replaces": "/query-route"
    },
    "IdRouteSource": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "SliceRoute"
          },
          {
            "type": "const",
            "value": "/{id:guid}"
          }
        ]
      }
    },
    "IdEndpointRoute": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "IdRouteSource",
        "steps": [
          {
            "regex": "^/?",
            "replacement": "/"
          }
        ]
      },
      "replaces": "/query-id-route"
    },
    "RouteIsGroup": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "SliceRoute",
        "pattern": "^$"
      }
    },
    "RouteHasParameters": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "SliceRoute",
        "pattern": "\\{"
      }
    },
    "RouteNamesId": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "SliceRoute",
        "pattern": "(?i)\\{id[:?}]"
      }
    },
    "RouteIsValid": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "SliceRoute",
        "pattern": "^(?:(?:[a-z0-9]+(?:-[a-z0-9]+)*|\\{[A-Za-z][A-Za-z0-9]*(?::[a-z]+(?:\\([^(){}/]*\\))?)*\\??\\})(?:/(?:[a-z0-9]+(?:-[a-z0-9]+)*|\\{[A-Za-z][A-Za-z0-9]*(?::[a-z]+(?:\\([^(){}/]*\\))?)*\\??\\}))*)?$"
      }
    },
    "HttpMethod": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "Method",
        "toLower": false
      },
      "fileRename": "HttpMethodName"
    },
    "MethodIsGet": {
      "type": "computed",
      "value": "(HttpMethod == \"GET\")"
    },
    "ResultIsSingle": {
      "type": "computed",
      "value": "(Result == \"single\")"
    },
    "ResultIsMany": {
      "type": "computed",
      "value": "(Result == \"many\")"
    },
    "ResultIsFiltered": {
      "type": "computed",
      "value": "(Result == \"filtered\")"
    },
    "ResultIsList": {
      "type": "computed",
      "value": "(Result != \"single\")"
    },
    "AppIsKnown": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "AppNameOrEmpty",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
      }
    },
    "NameIsGiven": {
      "type": "computed",
      "value": "(name != \"HardSliceNameMissing\")"
    },
    "NameIsPascalCase": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "name",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "NameHasSuffix": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "name",
        "pattern": "Query$"
      }
    },
    "ResultDto": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "^[A-Z][a-z0-9]+(?=[A-Z])",
            "replacement": ""
          },
          {
            "regex": "$",
            "replacement": "Dto"
          }
        ]
      },
      "replaces": "ResultDtoName",
      "fileRename": "ResultDtoName"
    },
    "ModuleIsPascalCase": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "Module",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "ModuleProbe": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "Module"
          },
          {
            "type": "const",
            "value": "|"
          },
          {
            "type": "ref",
            "value": "ModuleFiles"
          }
        ]
      }
    },
    "ModuleExists": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "ModuleProbe",
        "pattern": "^([A-Za-z0-9]+)\\|(?:.*;)?[^;]*[/\\\\]Features[/\\\\]\\1[/\\\\]\\1Module\\.cs(?:;|$)"
      }
    },
    "AggregateIsPascalCase": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "Aggregate",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "RouteHidesId": {
      "type": "computed",
      "value": "(ResultIsSingle && RouteNamesId)"
    },
    "ParameterIsMissing": {
      "type": "computed",
      "value": "(ResultIsFiltered && !ParameterIsGiven)"
    },
    "ParameterIsUnused": {
      "type": "computed",
      "value": "(!ResultIsFiltered && ParameterIsGiven)"
    },
    "ParameterIsMalformed": {
      "type": "computed",
      "value": "(ResultIsFiltered && ParameterIsGiven && !ParameterIsWellFormed)"
    },
    "ParameterTypeIsUnknown": {
      "type": "computed",
      "value": "(ResultIsFiltered && ParameterIsWellFormed && !FilterTypeIsKnown)"
    },
    "Accepted": {
      "type": "computed",
      "value": "(AppIsKnown && NameIsGiven && NameIsPascalCase && !NameHasSuffix && ModuleIsPascalCase && ModuleExists && AggregateIsPascalCase && RouteIsValid && !RouteHidesId && MethodIsGet && !ParameterIsMissing && !ParameterIsUnused && !ParameterIsMalformed && !ParameterTypeIsUnknown)"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!Accepted)",
          "exclude": [
            "**/*"
          ]
        },
        {
          "condition": "(!ResultIsFiltered)",
          "exclude": [
            "tests/MyApp.Tests/**/*"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "id": "refuseUnknownApplication",
      "condition": "(!AppIsKnown)",
      "description": "Refuses a solution whose web project it cannot read.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "args": {
        "jsonFileName": "hardslice-query.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: hardslice-query reads the application from its web project, which it could not evaluate. Run it from the root of the solution with --project src/<App>/<App>.csproj, once the solution is restored (after a first build or check), such as: dotnet new hardslice-query --project src/<App>/<App>.csproj --module <Module> --name <Name> --aggregate <Aggregate>. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseMissingName",
      "condition": "(!NameIsGiven)",
      "description": "Refuses a slice without name.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "args": {
        "jsonFileName": "hardslice-query.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --name is required: the use case in PascalCase, without the Query suffix, such as --name ListRoomBookings. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseInvalidName",
      "condition": "(!NameIsPascalCase)",
      "description": "Refuses a name that is not PascalCase.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-query.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --name 'QueryName' is not PascalCase: it names the slice folder, its namespace and its types, such as --name ListRoomBookings. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseQuerySuffix",
      "condition": "(NameHasSuffix)",
      "description": "Refuses a name with the Query suffix.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-query.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --name 'QueryName' ends with Query: pass the use case alone, the template names the query <Name>Query. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseInvalidModule",
      "condition": "(!ModuleIsPascalCase)",
      "description": "Refuses a module name that is not PascalCase.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-query.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --module 'ModuleName' is not PascalCase: pass the name of an existing module, such as the folder of src/MyApp/Features/<Module>/. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseMissingModule",
      "condition": "(!ModuleExists)",
      "description": "Refuses a module that does not exist.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-query.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: module 'ModuleName' does not exist: src/MyApp/Features/ModuleName/ModuleNameModule.cs was not found. Create the module first with dotnet new hardslice-module --project src/MyApp/MyApp.csproj --name ModuleName, then add the slice. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseInvalidAggregate",
      "condition": "(!AggregateIsPascalCase)",
      "description": "Refuses an aggregate name that is not PascalCase.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-query.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --aggregate 'AggregateName' is not PascalCase: pass the aggregate root that the query reads, a type of src/MyApp.Domain/<Module>/, such as --aggregate Booking. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseInvalidRoute",
      "condition": "(!RouteIsValid)",
      "description": "Refuses a route that ASP.NET Core or the tests could not use.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-query.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --route '/slice-route' is not a route of lowercase words separated by hyphens, and route parameters between braces such as {id:guid}, separated by slashes, such as --route trips or --route {roomId:guid}/bookings. Pass --route / for the group of the module itself. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseRouteThatHidesId",
      "condition": "(RouteHidesId)",
      "description": "Refuses a route that already holds the parameter that a single result appends.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-query.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --route '/slice-route' holds a parameter id, which --result single appends to it as /{id:guid} to read the aggregate by its identifier. Remove it from --route, such as --route trips, or pass / for the group of the module. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseCommandMethod",
      "condition": "(!MethodIsGet)",
      "description": "Refuses a method other than GET.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-query.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
