{
  "$schema": "http://json.schemastore.org/template",
  "author": "Vincent Augerot",
  "classifications": [
    "Web",
    "API",
    "Vertical Slices",
    "DDD"
  ],
  "identity": "HardSlice.Templates.Module",
  "name": "HardSlice module",
  "description": "A module of a hardslice-api solution: its public contract <Module>Module, which registers and maps its slices on one route group, the folder of its domain and its test folders. Run it from the root of the solution with --project src/<App>/<App>.csproj.",
  "shortName": "hardslice-module",
  "sourceName": "ModuleName",
  "preferNameDirectory": false,
  "preferDefaultName": true,
  "defaultName": "HardSliceNameMissing",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "Route": {
      "type": "parameter",
      "datatype": "text",
      "description": "The route of the group that maps the endpoints of the module: lowercase words separated by hyphens or slashes, such as meeting-rooms or /meeting-rooms. The name of the module in kebab-case by default, which the tests generated by hardslice-command and hardslice-query suppose."
    },
    "AppName": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "replaces": "MyApp",
      "fileRename": "MyApp"
    },
    "Unbound": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": ""
      }
    },
    "AppNameOrEmpty": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "AppName",
        "fallbackVariableName": "Unbound"
      }
    },
    "ModuleRouteWords": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "(?<=[a-z0-9])([A-Z])",
            "replacement": "-$1"
          }
        ]
      }
    },
    "ModuleRoute": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "ModuleRouteWords",
        "toLower": true
      }
    },
    "RouteOrDefault": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "Route",
        "fallbackVariableName": "ModuleRoute"
      }
    },
    "GroupRoute": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "RouteOrDefault",
        "steps": [
          {
            "regex": "^/",
            "replacement": ""
          }
        ]
      },
      "replaces": "module-route",
      "fileRename": "module-route"
    },
    "AppIsKnown": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "AppNameOrEmpty",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
      }
    },
    "NameIsGiven": {
      "type": "computed",
      "value": "(name != \"HardSliceNameMissing\")"
    },
    "NameIsPascalCase": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "name",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "NameHasSuffix": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "name",
        "pattern": "Module$"
      }
    },
    "RouteIsValid": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "GroupRoute",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
      }
    },
    "Accepted": {
      "type": "computed",
      "value": "(AppIsKnown && NameIsGiven && NameIsPascalCase && !NameHasSuffix && RouteIsValid)"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!Accepted)",
          "exclude": [
            "**/*"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "id": "refuseUnknownApplication",
      "condition": "(!AppIsKnown)",
      "description": "Refuses a solution whose web project it cannot read.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "args": {
        "jsonFileName": "hardslice-module.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: hardslice-module reads the application from its web project, which it could not evaluate. Run it from the root of the solution with --project src/<App>/<App>.csproj, once the solution is restored (after a first build or check), such as: dotnet new hardslice-module --project src/<App>/<App>.csproj --name <Module>. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseMissingName",
      "condition": "(!NameIsGiven)",
      "description": "Refuses a module without name.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "args": {
        "jsonFileName": "hardslice-module.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --name is required: the module in PascalCase, without the Module suffix, such as --name Rooms. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseInvalidName",
      "condition": "(!NameIsPascalCase)",
      "description": "Refuses a name that is not PascalCase.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-module.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --name 'ModuleName' is not PascalCase: it names the folders of the module, its namespaces and its contract, such as --name Rooms. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseModuleSuffix",
      "condition": "(NameHasSuffix)",
      "description": "Refuses a name with the Module suffix.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-module.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --name 'ModuleName' ends with Module: pass the module alone, the template names its contract <Name>Module. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "refuseInvalidRoute",
      "condition": "(!RouteIsValid)",
      "description": "Refuses a route that is not made of lowercase words.",
      "actionId": "695A3659-EB40-4FF5-A6A6-C9C4E629FCB0",
      "applyFileRenamesToManualInstructions": true,
      "args": {
        "jsonFileName": "hardslice-module.refused.json",
        "parentPropertyPath": "refused",
        "newJsonPropertyName": "refused",
        "newJsonPropertyValue": "refused"
      },
      "manualInstructions": [
        {
          "text": "error: --route '/module-route' is not a route of lowercase words separated by hyphens or slashes, such as --route meeting-rooms. Nothing was created."
        }
      ],
      "continueOnError": false
    },
    {
      "id": "registerModule",
      "condition": "(Accepted)",
      "description": "Lines to add to Program.cs.",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "applyFileRenamesToManualInstructions": true,
      "manualInstructions": [
        {
          "text": "Register the module in src/MyApp/Program.cs:\n1. Add the using:\nusing MyApp.Features.ModuleName;\n2. Register its services, before 'var app = builder.Build();':\nbuilder.Services.AddModuleNameModule();\n3. Map its endpoints, before 'app.Run();':\napp.MapModuleNameModule();\nIts endpoints answer under /module-route. Then add its aggregates with dotnet new hardslice-aggregate, its slices with dotnet new hardslice-command and hardslice-query, its events and their reactions with dotnet new hardslice-event, and the module to the map of AGENTS.md."
        }
      ],
      "continueOnError": true
    }
  ]
}
