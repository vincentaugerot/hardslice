<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TngTech.ArchUnitNET" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MyApp.Domain/MyApp.Domain.csproj" />
    <ProjectReference Include="../../src/MyApp/MyApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- hardslice.json, the domain project, the Shared folders and the test sources are read from the solution under test. -->
    <AssemblyMetadata Include="SolutionRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="HardSliceCollectTestInputs" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="../MyApp.Tests/MyApp.Tests.csproj;../MyApp.IntegrationTests/MyApp.IntegrationTests.csproj"
             Targets="HardSliceGetTestInputs" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_HardSliceTestInputs" />
    </MSBuild>
    <ItemGroup>
      <AssemblyMetadata Include="TestSymbols:%(_HardSliceTestInputs.Identity)" Value="%(_HardSliceTestInputs.Symbols)" />
      <AssemblyMetadata Include="TestSources:%(_HardSliceTestInputs.Identity)" Value="%(_HardSliceTestInputs.Sources)" />
    </ItemGroup>
  </Target>

</Project>
