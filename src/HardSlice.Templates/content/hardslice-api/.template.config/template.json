{
  "$schema": "http://json.schemastore.org/template",
  "author": "Vincent Augerot",
  "classifications": ["Web", "API", "Vertical Slices", "DDD"],
  "identity": "HardSlice.Templates.Api",
  "name": "HardSlice API",
  "description": "ASP.NET Core API in vertical slices with a rich domain, enforced at build time by HardSlice.Analyzers.",
  "shortName": "hardslice-api",
  "preferNameDirectory": true,
  "guids": ["5d0a9c3e-7b41-4f6a-9e28-c1b4a7f3d206"],
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "forms": {
    "safe_namespace": { "identifier": "safe_namespace" },
    "lower_safe_namespace": { "identifier": "lower_safe_namespace" },
    "without_leading_underscores": {
      "identifier": "replace",
      "pattern": "^_+",
      "replacement": ""
    },
    "lower_without_leading_underscores": {
      "identifier": "chain",
      "steps": ["lower_safe_namespace", "without_leading_underscores"]
    }
  },
  "symbols": {
    "AppName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_namespace",
      "replaces": "MyApp",
      "fileRename": "MyApp",
      "description": "The name of the application in its single form, a safe namespace: my-app becomes my_app, 1Rooms becomes _1Rooms, Acme.Rooms stays Acme.Rooms. It names every folder, project, assembly and namespace."
    },
    "AppNameLower": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lower_without_leading_underscores",
      "replaces": "myapp",
      "description": "The same name in lower case, without the leading underscores that a container name refuses: the local database and its container."
    },
    "HostOS": {
      "type": "bind",
      "binding": "env:OS",
      "defaultValue": "",
      "description": "Windows_NT on Windows, where files have no executable bit: the other systems make the scripts executable."
    },
    "NoSample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Generates the foundation without the Bookings sample module: no sample domain, slices, tests or migrations."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(NoSample)",
          "exclude": [
            "src/MyApp.Domain/Bookings/**",
            "src/MyApp/Features/Bookings/**",
            "src/MyApp/Shared/Persistence/Migrations/**",
            "tests/MyApp.Tests/Domain/Bookings/**",
            "tests/MyApp.Tests/Features/Bookings/**",
            "tests/MyApp.IntegrationTests/Features/Bookings/**"
          ]
        }
      ]
    },
    {
      "target": "./.hardslice/generation/",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "**/*.filelist",
        "**/*.user",
        "**/*.lock.json",
        "**/.editorconfig",
        "**/.globalconfig",
        "**/Directory.Build.props",
        "**/Directory.Build.targets",
        "**/Directory.Build.rsp",
        "hardslice.json",
        "Directory.HardSlice.props",
        ".config/dotnet-tools.json",
        ".github/workflows/hardslice.yml",
        "Directory.Solution.props",
        "Directory.Solution.targets",
        "nuget.config",
        "scripts/**",
        "tests/MyApp.ArchitectureTests/**",
        ".claude/**",
        ".agents/**",
        ".codex/**",
        ".github/hooks/**",
        ".githooks/**",
        ".hardslice/generation/**",
        "docs/rules/**",
        "GEMINI.md",
        ".github/copilot-instructions.md"
      ],
      "modifiers": [
        {
          "condition": "(NoSample)",
          "exclude": [
            "src/MyApp.Domain/Bookings/**",
            "src/MyApp/Features/Bookings/**",
            "src/MyApp/Shared/Persistence/Migrations/**",
            "tests/MyApp.Tests/Domain/Bookings/**",
            "tests/MyApp.Tests/Features/Bookings/**",
            "tests/MyApp.IntegrationTests/Features/Bookings/**"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "id": "makeScriptsExecutable",
      "condition": "(HostOS != \"Windows_NT\")",
      "description": "Makes the pre-commit hook and the check script executable: the package does not keep the executable bit.",
      "actionId": "cb9a6cf3-4f5c-4860-b9d2-03a574959774",
      "args": {
        "+x": [".githooks/pre-commit", "scripts/check.sh"]
      },
      "manualInstructions": [
        {
          "text": "Make the pre-commit hook and the check script executable: chmod +x .githooks/pre-commit scripts/check.sh"
        }
      ],
      "continueOnError": true
    }
  ]
}
