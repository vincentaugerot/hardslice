{
  "$schema": "http://json.schemastore.org/template",
  "author": "Vincent Augerot",
  "classifications": ["Web", "API", "Vertical Slices", "DDD"],
  "identity": "HardSlice.Templates.Api",
  "name": "HardSlice API",
  "description": "ASP.NET Core API in vertical slices with a rich domain, enforced at build time by HardSlice.Analyzers.",
  "shortName": "hardslice-api",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "forms": {
    "safe_namespace": { "identifier": "safe_namespace" },
    "lower_safe_namespace": { "identifier": "lower_safe_namespace" },
    "without_leading_underscores": {
      "identifier": "replace",
      "pattern": "^_+",
      "replacement": ""
    },
    "lower_without_leading_underscores": {
      "identifier": "chain",
      "steps": ["lower_safe_namespace", "without_leading_underscores"]
    }
  },
  "symbols": {
    "AppName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_namespace",
      "replaces": "MyApp",
      "fileRename": "MyApp",
      "description": "The name of the application in its single form, a safe namespace: my-app becomes my_app, 1Rooms becomes _1Rooms, Acme.Rooms stays Acme.Rooms. It names every folder, project, assembly and namespace."
    },
    "AppNameLower": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lower_without_leading_underscores",
      "replaces": "myapp",
      "description": "The same name in lower case, without the leading underscores that a container name refuses: the local database and its container."
    },
    "NoSample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Generates the foundation without the Bookings sample module: no sample domain, slices, tests or migrations."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(NoSample)",
          "exclude": [
            "src/MyApp.Domain/Bookings/**",
            "src/MyApp/Features/Bookings/**",
            "src/MyApp/Shared/Persistence/Migrations/**",
            "tests/MyApp.Tests/Domain/Bookings/**",
            "tests/MyApp.Tests/Features/Bookings/**",
            "tests/MyApp.IntegrationTests/Features/Bookings/**",
            "tests/MyApp.IntegrationTests/Shared/Behaviors/TransactionBehaviorTests.cs",
            "tests/MyApp.IntegrationTests/Shared/Behaviors/DomainEventPublisherTests.cs"
          ]
        }
      ]
    }
  ]
}
