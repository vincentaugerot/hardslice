<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- The packages of the application: add a dependency here, with its version, and reference it from the project that uses it.
       The import brings HardSlice.Analyzers, from a protected file: keep it. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.HardSlice.props" />

  <ItemGroup Label="Persistence">
    <!-- Pins the EF Core version that Npgsql brings transitively to the one of the dotnet-ef tooling. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- MIT. FakeTimeProvider, the clock that tests set and advance (docs/rules/HS010.md). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- Apache-2.0. Loads the compiled assemblies and their dependency graph for the architecture tests. -->
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
    <!-- MIT. Parses the test sources for HS014 and HS018, without building the test projects. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
</Project>
