<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--#if (false)
  The repository builds the template content without HardSlice.Analyzers: dotnet new uncomments the next block in generated solutions.
  The pack of HardSlice.Templates writes the version of the HardSlice packages in place of the version of this reference.
  #endif -->
  <!--#if (true)
  <ItemGroup Label="Analyzers">
    <GlobalPackageReference Include="HardSlice.Analyzers" Version="HARDSLICE_VERSION" />
  </ItemGroup>
  #endif -->

  <ItemGroup Label="Persistence">
    <!-- Pins the EF Core version that Npgsql brings transitively to the one of the dotnet-ef tooling. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- Apache-2.0. Loads the compiled assemblies and their dependency graph for the architecture tests. -->
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
    <!-- MIT. Parses the test sources for HS014 and HS018, without building the test projects. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
</Project>
