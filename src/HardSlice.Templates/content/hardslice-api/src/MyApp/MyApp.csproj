<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- dotnet new gives each solution its own identifier: dotnet user-secrets needs no init. -->
    <UserSecretsId>5d0a9c3e-7b41-4f6a-9e28-c1b4a7f3d206</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Needed by dotnet-ef to create and apply migrations; not used by the application code. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MyApp.Domain/MyApp.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyApp.Tests" />
    <InternalsVisibleTo Include="MyApp.IntegrationTests" />
  </ItemGroup>

</Project>
