<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>HardSlice.Templates</PackageId>
    <Description>dotnet new templates for HardSlice: vertical slices with a rich domain, enforced by the build.</Description>
    <PackageTags>dotnet-new;templates;architecture;vertical-slices;ddd;cqrs</PackageTags>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- NU5110/NU5111: scripts/check.ps1 is template content, not a NuGet install script. -->
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**;content/**/TestResults/**" />
    <Compile Remove="**/*" />
  </ItemGroup>

</Project>
