# HardSlice analysis mode 'Recommended', the default: every rule that can block the build. The default severities of the analyzers match it.
# Added by build/HardSlice.Analyzers.targets when HardSliceAnalysisMode is 'Recommended'.
# A mode turns a rule on or off, at its own severity: it never changes the severity of a rule it keeps.
# A setting of .editorconfig, or of a global config of the solution, takes precedence over it (global_level -1).
# Every rule of HardSlice.Analyzers has a line in each mode.

is_global = true
global_level = -1

# HS003: an endpoint never reaches the database.
dotnet_diagnostic.HS003.severity = error

# HS004: a slice holds one request named after it, its handler and its endpoint, in its own folder.
dotnet_diagnostic.HS004.severity = error

# HS010: the domain and the slices never read the system clock.
dotnet_diagnostic.HS010.severity = error

# HS011: code never blocks on asynchronous work and never declares async void.
dotnet_diagnostic.HS011.severity = error

# HS015: the endpoint of a slice stays in its slice, on the group of its module, and returns TypedResults.
dotnet_diagnostic.HS015.severity = error

# HS016: a slice never uses a type of another slice.
dotnet_diagnostic.HS016.severity = error

# HS900 to HS902: the contracts that classify types are usable, unambiguous and cover every mapped entity.
# Reported only when an active rule depends on the classification.
dotnet_diagnostic.HS900.severity = error
dotnet_diagnostic.HS901.severity = error
dotnet_diagnostic.HS902.severity = error
