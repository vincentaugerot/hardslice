<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn loads analyzers in every compiler host (CLI, Visual Studio, Rider): netstandard2.0 is mandatory. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Analyzer packages contain build-time assets only: never expose this assembly as a runtime library. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageId>HardSlice.Analyzers</PackageId>
    <Description>Roslyn analyzers that keep a HardSlice solution in vertical slices around a rich domain: a violation fails the build with a diagnostic that names the fix and the rule sheet.</Description>
    <PackageTags>roslyn;analyzers;architecture;vertical-slice-architecture;ddd;cqrs;ai;coding-agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="$(TargetPath)"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <!-- Imported by the package reference: hardslice.json and the MSBuild properties the analyzers read. -->
    <None Include="build/HardSlice.Analyzers.props;build/HardSlice.Analyzers.targets"
          Pack="true"
          PackagePath="build" />
    <!-- One global config per analysis mode, selected by HardSliceAnalysisMode in build/HardSlice.Analyzers.targets. -->
    <None Include="build/*.globalconfig"
          Pack="true"
          PackagePath="build" />
  </ItemGroup>

</Project>
